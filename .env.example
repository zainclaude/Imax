# --- AMC data source ---
# Preferred: official AMC developer API key (https://developers.amc.com/).
# If set, the monitor uses the sanctioned API instead of scraping HTML.
AMC_API_KEY=

# AMC theatre id for Lincoln Square 13. Confirm with:
#   python -m amc_monitor.find_theatre "Lincoln Square"
AMC_THEATRE_ID=

# --- What to watch ---
MOVIE_QUERY=Odyssey
FORMAT_MATCH=70

# --- When to text you (choose one or more, comma-separated) ---
#   new_date       Text when a brand-new bookable DATE appears — i.e. the booking
#                  horizon extends (Aug 16 was the max, now Aug 17 shows up). This
#                  is the "a whole new day / fresh batch of seats" alert.
#   adjacent_pair  Text when a showtime has two open seats next to each other.
#   any_showtime   Text on any newly-seen showtime slot.
# Default is new_date. Example for both: ALERT_MODE=new_date,adjacent_pair
ALERT_MODE=new_date

# --- Politeness ---
# Base seconds between polls. Keep this humane (>= 120). Jitter is added.
POLL_SECONDS=180

# --- Twilio / alerting ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# You + your wife, comma separated, E.164 format:
ALERT_NUMBERS=+1XXXXXXXXXX,+1XXXXXXXXXX
# Optional: set to use a shared Group MMS thread instead of two 1:1 texts.
TWILIO_MESSAGING_SERVICE_SID=
