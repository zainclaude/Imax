# --- AMC data source ---
# Preferred: official AMC developer API key (https://developers.amc.com/).
# If set, the monitor uses the sanctioned API instead of scraping HTML.
AMC_API_KEY=

# AMC numeric theatre id — only needed WITH an API key. Confirm with:
#   python -m amc_monitor.find_theatre "Lincoln Square"
AMC_THEATRE_ID=

# Without an API key, the monitor reads the public dated showtimes pages
# (?date=YYYY-MM-DD). Defaults to Lincoln Square; override for another theatre:
AMC_SHOWTIMES_URL=https://www.amctheatres.com/movie-theatres/new-york-city/amc-lincoln-square-13/showtimes
# Days forward the one-time seed scan walks to find the booking horizon:
HORIZON_SCAN_DAYS=45
# Where the seed scan starts, days from today. The bookable frontier for a hot
# limited run sits ~a month out (near dates sold out/unlisted). Default 30.
SCAN_START_DAYS=30

# --- What to watch ---
MOVIE_QUERY=Odyssey
FORMAT_MATCH=70

# --- When to text you (choose one or more, comma-separated) ---
#   new_date       Text when a brand-new bookable DATE appears — i.e. the booking
#                  horizon extends (Aug 16 was the max, now Aug 17 shows up). This
#                  is the "a whole new day / fresh batch of seats" alert.
#   adjacent_pair  Text when a showtime has two open seats next to each other.
#   any_showtime   Text on any newly-seen showtime slot.
# Default is new_date. Example for both: ALERT_MODE=new_date,adjacent_pair
ALERT_MODE=new_date

# --- Politeness ---
# Base seconds between polls. Keep this humane (>= 120). Jitter is added.
POLL_SECONDS=180

# --- Twilio / alerting ---
# Account SID (starts with AC...). Required for ALL auth styles below — even
# OAuth, because the Messages API URL is scoped by account.
TWILIO_ACCOUNT_SID=
#
# Auth — pick ONE of these three styles:
#   (A) Auth Token (simplest):
TWILIO_AUTH_TOKEN=
#   (B) API Key (revocable): SID starts with SK..., plus its secret.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
#   (C) OAuth 2.0 client credentials (short-lived Bearer tokens):
TWILIO_CLIENT_ID=
TWILIO_CLIENT_SECRET=
#
# Sender: a Twilio phone number you own (E.164), e.g. +1XXXXXXXXXX
TWILIO_FROM=
# Optional: set to use a shared Group MMS thread instead of two 1:1 texts.
TWILIO_MESSAGING_SERVICE_SID=
#
# Recipients (you + your wife), comma separated, E.164 format:
ALERT_NUMBERS=+1XXXXXXXXXX,+1XXXXXXXXXX

# --- Email channel (alternative/additional to SMS) ---
# Works immediately — no carrier registration needed. Recipients can be normal
# inboxes (reliable, pushes via the Mail app) and/or carrier email-to-SMS
# gateways where the carrier still supports them:
#   Verizon:  <10digits>@vtext.com      T-Mobile: <10digits>@tmomail.net
#   (AT&T discontinued its email-to-text gateway in 2025.)
# For Gmail/Google Workspace: SMTP_USER is your address, SMTP_PASS is an App
# Password (myaccount.google.com/apppasswords — requires 2-step verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=

# --- ntfy push channel (free instant app notifications, no account needed) ---
# 1. Both phones install the "ntfy" app (App Store / Play Store).
# 2. In the app: + Subscribe to topic -> enter the SAME topic name as below.
# 3. Set that topic here. The topic name acts as a password — make it long and
#    random (anyone who guesses it can see and send alerts).
NTFY_TOPIC=
# Optional: self-hosted ntfy server. Default is the free public https://ntfy.sh.
NTFY_SERVER=https://ntfy.sh

# --- Proof of life ---
# Push a check-in every N hours reporting the furthest bookable date
# ("furthest bookable date is still Sun Aug 17"). Hearing the same date each
# hour confirms the bot is alive AND hasn't missed a drop; if check-ins stop,
# the monitor is down. Default 1 (hourly). Empty disables. Minimum 0.25.
HEARTBEAT_HOURS=1
